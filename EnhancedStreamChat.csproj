<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>9</LangVersion>
    <Nullable>annotations</Nullable>
    <NoWarn>1591</NoWarn>
    <AssemblyName>EnhancedStreamChat</AssemblyName>
    <RootNamespace>EnhancedStreamChat</RootNamespace>
    <OutDir>$(ProjectDir)bin\$(Configuration)</OutDir>
    <GameDirPath>D:\Program Files (x86)\Steam\steamapps\common\BSManager\BSInstances\1.40.4</GameDirPath>
    <BeatSaberDir>D:\Program Files (x86)\Steam\steamapps\common\BSManager\BSInstances\1.40.4</BeatSaberDir>
    <Version>10.1.0</Version>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
    <AssemblySearchPath>$(ReferencePath)</AssemblySearchPath>
    <!-- 优先使用游戏目录里安装的 CatCore，缺省回落到仓库自带的编译引用 -->
    <CatCorePath Condition="Exists('$(BeatSaberDir)\Libs\CatCore.dll')">$(BeatSaberDir)\Libs\CatCore.dll</CatCorePath>
    <CatCorePath Condition="'$(CatCorePath)' == ''">$(ProjectDir)Libs\CatCore\CatCore.dll</CatCorePath>
    <ManifestPath>manifest.json</ManifestPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <DocumentationFile>$(OutDir)\EnhancedStreamChat.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
